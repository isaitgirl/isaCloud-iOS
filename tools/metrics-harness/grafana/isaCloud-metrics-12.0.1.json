      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "from(bucket: \"isacloud_ios\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"isacloud_metrics\")\n  |> filter(fn: (r) => r[\"_field\"] == \"cpu_ms\")\n  |> map(fn: (r) => ({ r with _value: float(v: r._value) }))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> group(columns: [\"_field\"])\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "from(bucket: \"isacloud_ios\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"isacloud_metrics\")\n  |> filter(fn: (r) => r[\"_field\"] == \"cpu_ms\" or r[\"_field\"] == \"wall_ms\")\n  |> keep(columns: [\"_time\", \"build\", \"_field\", \"_value\"])\n  |> group(columns: [\"_time\", \"build\", \"_field\"])\n  |> mean()\n  |> pivot(rowKey: [\"_time\", \"build\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.cpu_ms and exists r.wall_ms and r.wall_ms > 0.0)\n  |> map(fn: (r) => ({\n    _time: r._time,\n    _field: \"taxa (%)\",\n    _value: float(v: r.cpu_ms) / float(v: r.wall_ms) * 100.0\n  }))\n  |> group(columns: [\"_field\"])",
          "rawQuery": true,
          "refId": "B",
          "resultFormat": "time_series"
        }
      ],
      "title": "CPU (ms por amostra e taxa)",
      "type": "timeseries"
