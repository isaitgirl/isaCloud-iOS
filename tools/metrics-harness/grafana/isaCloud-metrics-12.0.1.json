          "query": "from(bucket: \"isacloud_ios\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"isacloud_metrics\" and r[\"_field\"] == \"mem_footprint_mb\")\n  |> group(columns: [\"build\"])\n  |> first()\n  |> group()\n  |> map(fn: (r) => ({_time: r._time, title: \"build \" + r.build, text: \"primeira amostra do build \" + r.build}))\n  |> keep(columns: [\"_time\", \"title\", \"text\"])",
