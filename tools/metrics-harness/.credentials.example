# Copie este arquivo para ".credentials" (no mesmo diretório do send.py) e
# preencha com os valores do seu InfluxDB 2.x. O ".credentials" é ignorado
# pelo Git e nunca deve ser commitado.
#
# Formato: CHAVE=valor, uma por linha. Linhas em branco e comentários (#) são
# ignorados. Valores podem vir entre aspas simples ou duplas (sem aspas é o
# mais comum). Nada de comentário no fim da linha: o "#" só vale no começo.

# URL base do InfluxDB 2.x (sem /api/v2, sem barra no fim).
INFLUX_URL=http://localhost:8086

# Token de API com permissão de escrita no bucket (InfluxDB: Data > Tokens).
# É um segredo: não cole em issue, print, commit ou mensagem.
INFLUX_TOKEN=exemplo-token-de-escrita-nao-use-em-producao

# Organização dona do bucket (InfluxDB: ícone de engrenagem > Organization).
INFLUX_ORG=isacloud

# Bucket de destino. Opcional; se omitido, usa "isacloud".
INFLUX_BUCKET=isacloud_ios

# Nome da measurement das amostras. O harness grava "<valor>_metrickit" para
# os payloads MetricKit. Opcional na prática? Não: é obrigatório.
INFLUX_MEASUREMENT=isacloud_metrics

# Timeout de cada POST em segundos. Opcional; padrão 10.
INFLUX_TIMEOUT=10
