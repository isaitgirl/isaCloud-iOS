+
+/// XEP-0357 uses `last-message-body` only for pushes that `mod_cloud_notify`
+/// considers important (messages with a body, OMEMO/encrypted payloads and
+/// calls). Pushes without that field are wake-ups for presence, receipts,
+/// chat states, pings and similar events.
+#[inline(always)]
+fn payload_has_last_message_body(payload: &Element) -> bool {
+    let form = match payload.get_child("x", "jabber:x:data") {
+        Some(form) => form,
+        None => return false,
+    };
+    for field in form.children() {
+        if field.is("field", "jabber:x:data") && field.attr("var") == Some("last-message-body") {
+            return field
+                .get_child("value", "jabber:x:data")
+                .map(|value| !value.text().trim().is_empty())
+                .unwrap_or(false);
+        }
+    }
+    false
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn parse(xml: &str) -> Result<(String, String, bool)> {
+        let element = Element::from_reader(xml.as_bytes()).unwrap();
+        parse_token_and_module_id(element)
+    }
+
+    #[test]
+    fn parses_important_push() {
+        let (module_id, token, important) = parse(
+            r#"<pubsub xmlns='http://jabber.org/protocol/pubsub'>
+                <publish node='device-token'>
+                    <item>
+                        <notification xmlns='urn:xmpp:push:0'>
+                            <x xmlns='jabber:x:data' type='form'>
+                                <field var='last-message-body' type='text-single'>
+                                    <value>New Message!</value>
+                                </field>
+                            </x>
+                        </notification>
+                    </item>
+                </publish>
+            </pubsub>"#,
+        )
+        .unwrap();
+        assert_eq!(module_id, "default");
+        assert_eq!(token, "device-token");
+        assert!(important);
+    }
+
+    #[test]
+    fn parses_unimportant_push() {
+        let (module_id, token, important) = parse(
+            r#"<pubsub xmlns='http://jabber.org/protocol/pubsub'>
+                <publish node='device-token'>
+                    <item>
+                        <notification xmlns='urn:xmpp:push:0'>
+                            <x xmlns='jabber:x:data' type='form'>
+                                <field var='message-count' type='text-single'>
+                                    <value>1</value>
+                                </field>
+                            </x>
+                        </notification>
+                    </item>
+                </publish>
+            </pubsub>"#,
+        )
+        .unwrap();
+        assert_eq!(module_id, "default");
+        assert_eq!(token, "device-token");
+        assert!(!important);
+    }
+}
